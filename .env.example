# =============================================================================
# KeenPay — environment template
# Copy to .env and fill values. Never commit .env.
# =============================================================================

# --- App ---
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Auth ---
JWT_SECRET=change-me-in-production-use-32-plus-random-bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7
# The name this service answers to in a token's `aud` claim. A credential
# minted for any other audience is refused even when correctly signed.
CONTROL_PLANE_AUDIENCE=keenpay-control-plane
# Agent credentials are short-lived by design. Default 15 minutes, hard cap 1h.
AGENT_TOKEN_TTL_SECONDS=900
AGENT_TOKEN_MAX_TTL_SECONDS=3600

# --- PostgreSQL ---
# keenpay_app is NOBYPASSRLS and owns nothing, so every row-level policy
# applies to it. Connecting as a superuser here would silently disable
# tenant isolation for the whole application.
DATABASE_URL=postgresql+asyncpg://keenpay_app:keenpay_app_dev_only@localhost:5432/keenpay

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- LLM (parse_intent + negotiate_offer only) ---
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=10

# --- Razorpay (test mode for dev) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MOCK=true

# --- Merchant policy ---
MERCHANT_POLICY_JSON=./api/config/merchant_policy.json

# --- Feature flags ---
ENABLE_DEV_ROUTES=true
ENABLE_TRACE_STREAMING=true
ENABLE_METRICS=true

# --- Storage mode (true = in-memory repos, for tests without Postgres) ---
USE_IN_MEMORY_STORE=false

# --- Worker ---
WORKER_CONCURRENCY=2

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- AI Runtime (separate service; deliberately holds no DB or payment keys) --
# Every variable is AI_-prefixed so a Control Plane .env mounted into that
# container grants it nothing: DATABASE_URL is not AI_DATABASE_URL, and the
# runtime has no field for either.
AI_APP_ENV=development
AI_LOG_LEVEL=INFO
AI_PORT=8100
AI_CONTROL_PLANE_URL=http://localhost:8000
AI_AGENT_AUDIENCE=keenpay-control-plane
# Short-lived, audience-restricted agent token. Optional for local runs; in
# deployment the token is passed per request instead, so its life is a run's.
AI_AGENT_TOKEN=
AI_MAX_TOOL_CALLS=12
AI_MAX_RECOMMENDATIONS=5
# Per-run ceiling on what the agent may ask to be authorized, in paise.
AI_MAX_REQUEST_AMOUNT_PAISE=5000000
# Empty selects the deterministic planner: no model provider, identical output
# for identical input. Set both to enable model-backed reasoning.
AI_LLM_MODEL=
AI_LLM_API_KEY=
