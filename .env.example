# =============================================================================
# KeenPay — environment template
# Copy to .env and fill values. Never commit .env.
# =============================================================================

# --- App ---
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Auth ---
JWT_SECRET=change-me-in-production-use-32-plus-random-bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://keenpay:keenpay@localhost:5432/keenpay

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- LLM (parse_intent + negotiate_offer only) ---
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=10

# --- Razorpay (test mode for dev) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MOCK=true

# --- Merchant policy ---
MERCHANT_POLICY_JSON=./api/config/merchant_policy.json

# --- Feature flags ---
ENABLE_DEV_ROUTES=true
ENABLE_TRACE_STREAMING=true
ENABLE_METRICS=true

# --- Storage mode (true = in-memory repos, for tests without Postgres) ---
USE_IN_MEMORY_STORE=false

# --- Worker ---
WORKER_CONCURRENCY=2

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
